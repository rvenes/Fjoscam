{
  "name": "fjoscam",
  "version": "1.0.8",
  "description": "Low-latency Reolink LAN viewer for lambing season monitoring.",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && electron .",
    "verify:vendor": "node scripts/verifyVendor.cjs",
    "build": "npm run verify:vendor && tsc -p tsconfig.json && tsc -p tsconfig.electron.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": "^22.23.2 || ^24.19.0",
    "npm": ">=10.9.8 <13"
  },
  "packageManager": "npm@10.9.8",
  "build": {
    "appId": "no.fjoscam.viewer",
    "productName": "Fjoscam",
    "afterPack": "scripts/packageVendor.cjs",
    "afterSign": "scripts/verifyMacSignature.cjs",
    "files": [
      "dist-renderer/**",
      "dist-electron/**",
      "vendor/go2rtc/**",
      "!vendor/go2rtc/{win64,mac-amd64,mac-arm64}{,/**}",
      "package.json"
    ],
    "asarUnpack": [
      "vendor/go2rtc/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.video",
      "identity": "Apple Development: rune@venes.org (X788384FY7)"
    },
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://venes.org/fjoscam/"
      }
    ]
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.20.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "9.2.4",
    "electron": "43.7.3",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  }
}
